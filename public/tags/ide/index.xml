&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;    &lt;span style=&#34;color:#a6e22e&#34;&gt;org&lt;/span&gt;.&lt;span style=&#34;color:#a6e22e&#34;&gt;springframework&lt;/span&gt;.&lt;span style=&#34;color:#a6e22e&#34;&gt;boot&lt;/span&gt;.&lt;span style=&#34;color:#a6e22e&#34;&gt;web&lt;/span&gt;.&lt;span style=&#34;color:#a6e22e&#34;&gt;support&lt;/span&gt;.&lt;span style=&#34;color:#a6e22e&#34;&gt;SpringBootServletInitializer&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;        at org.&lt;span style=&#34;color:#a6e22e&#34;&gt;springframework&lt;/span&gt;.&lt;span style=&#34;color:#a6e22e&#34;&gt;core&lt;/span&gt;.&lt;span style=&#34;color:#a6e22e&#34;&gt;type&lt;/span&gt;.&lt;span style=&#34;color:#a6e22e&#34;&gt;StandardAnnotationMetadata&lt;/span&gt;.
